{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eelsdb",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  // Fonts and logo files for the share cards (src/og/), bundled into the Worker.
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"] },
    { "type": "Text", "globs": ["**/*.svg"] }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eelsdb",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "eelsdb-files" }],
  // Simulated locally (wrangler dev and the tests). Before deploying, onboard a sending domain in the
  // Cloudflare account (Email Sending) and set EMAIL_PROVIDER=cloudflare and EMAIL_FROM on that domain.
  "send_email": [{ "name": "EMAIL" }],
  // Daily: delete drafts that were never submitted.
  "triggers": { "crons": ["17 3 * * *"] }
}
