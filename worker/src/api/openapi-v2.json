{
 "openapi": "3.1.0",
 "info": {
  "title": "EELS Data Base API v2",
  "version": "2",
  "description": "Read-only JSON API with typed values: numbers are numbers, units are in the field names, and acquisition values say where they came from. No key is needed. Responses have `Access-Control-Allow-Origin: *`. Errors return `{\"error\": {\"code\", \"message\"}}`. Field names follow HyperSpy's metadata where they can (beam energy in kV, angles in mrad)."
 },
 "servers": [
  {
   "url": "https://api.eelsdb.eu/v2"
  }
 ],
 "paths": {
  "/spectra": {
   "get": {
    "summary": "List spectra",
    "description": "Published spectra matching all given filters, with a total count and links to the next and previous pages. An unknown query parameter returns 400. Gas-phase spectra are included only when `phase=gas` is given.",
    "parameters": [
     {
      "name": "type",
      "in": "query",
      "description": "Spectrum type.",
      "schema": {
       "type": "string",
       "enum": [
        "coreloss",
        "lowloss",
        "zeroloss",
        "xrayabs"
       ]
      }
     },
     {
      "name": "technique",
      "in": "query",
      "description": "Measurement technique.",
      "schema": {
       "type": "string",
       "enum": [
        "eels",
        "xas"
       ]
      }
     },
     {
      "name": "phase",
      "in": "query",
      "description": "Specimen phase.",
      "schema": {
       "type": "string",
       "enum": [
        "solid",
        "liquid",
        "gas"
       ]
      }
     },
     {
      "name": "element",
      "in": "query",
      "description": "Element symbol; repeat to require several (all must be present).",
      "schema": {
       "type": "string"
      },
      "example": "Fe"
     },
     {
      "name": "edge",
      "in": "query",
      "description": "Edge, matched whole: `L2,3` (any element) or `Fe_L2,3`. Repeat to require several.",
      "schema": {
       "type": "string"
      },
      "example": "Fe_L2,3"
     },
     {
      "name": "formula",
      "in": "query",
      "description": "Text the formula contains.",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "q",
      "in": "query",
      "description": "Text in the title or description.",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "author",
      "in": "query",
      "description": "Part of the contributor's name, or their profile name.",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "complete",
      "in": "query",
      "description": "`true`: only spectra whose beam energy and both angles are known.",
      "schema": {
       "type": "string",
       "enum": [
        "true"
       ]
      }
     },
     {
      "name": "monochromated",
      "in": "query",
      "description": "Monochromated or not.",
      "schema": {
       "type": "string",
       "enum": [
        "true",
        "false"
       ]
      }
     },
     {
      "name": "min_energy_ev",
      "in": "query",
      "description": "Spectra starting at or above this energy (eV).",
      "schema": {
       "type": "number"
      }
     },
     {
      "name": "max_energy_ev",
      "in": "query",
      "description": "Spectra ending at or below this energy (eV).",
      "schema": {
       "type": "number"
      }
     },
     {
      "name": "covers_ev",
      "in": "query",
      "description": "Spectra whose energy range includes this energy (eV).",
      "schema": {
       "type": "number"
      },
      "example": 708
     },
     {
      "name": "beam_energy_kv",
      "in": "query",
      "description": "Beam energy (kV).",
      "schema": {
       "type": "number"
      }
     },
     {
      "name": "sort",
      "in": "query",
      "description": "Sort key; missing values sort last.",
      "schema": {
       "type": "string",
       "enum": [
        "formula",
        "title",
        "published_at",
        "min_energy_ev",
        "max_energy_ev",
        "beam_energy_kv",
        "resolution_ev",
        "id"
       ],
       "default": "formula"
      }
     },
     {
      "name": "order",
      "in": "query",
      "description": "Sort direction.",
      "schema": {
       "type": "string",
       "enum": [
        "asc",
        "desc"
       ],
       "default": "asc"
      }
     },
     {
      "name": "page",
      "in": "query",
      "description": "Page number, from 1.",
      "schema": {
       "type": "integer",
       "default": 1
      }
     },
     {
      "name": "per_page",
      "in": "query",
      "description": "Spectra per page, at most 500.",
      "schema": {
       "type": "integer",
       "default": 50
      }
     }
    ],
    "responses": {
     "200": {
      "description": "A page of spectra.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "total": {
           "type": "integer"
          },
          "page": {
           "type": "integer"
          },
          "per_page": {
           "type": "integer"
          },
          "next": {
           "type": [
            "string",
            "null"
           ]
          },
          "previous": {
           "type": [
            "string",
            "null"
           ]
          },
          "results": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Spectrum"
           }
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Unknown or invalid parameter.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/spectra/{id}": {
   "get": {
    "summary": "One spectrum",
    "description": "By numeric id or by slug.",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "description": "Numeric id (the old WordPress id for migrated spectra) or slug.",
      "schema": {
       "type": "string"
      },
      "example": "21751"
     }
    ],
    "responses": {
     "200": {
      "description": "A spectrum.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Spectrum"
        }
       }
      }
     },
     "404": {
      "description": "Not found.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "object",
      "properties": {
       "code": {
