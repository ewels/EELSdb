           "profile",
           "user",
           "estimate",
           "unknown",
           null
          ]
         },
         "uncertainty_mrad": {
          "type": [
           "number",
           "null"
          ]
         }
        }
       },
       "resolution_ev": {
        "type": [
         "number",
         "null"
        ]
       },
       "monochromated": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "dispersion_ev": {
        "type": [
