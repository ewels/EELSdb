# Copy to .env (gitignored) and fill in; wrangler dev loads it. OAuth apps need the redirect URL
# http://localhost:8787/auth/{orcid|google|github}/callback for local development.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# https://sandbox.orcid.org for ORCID's sandbox
ORCID_BASE=https://orcid.org
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# "log" writes emails to the Worker log; "cloudflare" sends through Cloudflare Email Service (the EMAIL binding)
EMAIL_PROVIDER=log
# From address for the cloudflare provider, on a domain onboarded to Email Sending
EMAIL_FROM=
# Where contact form messages go when no administrator has a confirmed address
CONTACT_EMAIL=
# "1" lets migrated accounts sign in with their old WordPress password (CPU-heavy; each is rehashed to PBKDF2 on first use)
LEGACY_PASSWORD_LOGIN=0
# Turnstile on the submit form; without a secret the check is skipped (local development)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Public address of the site (default in wrangler.jsonc: https://eelsdb.eu); the API is the same host with "api."
# in front. http://localhost:8787 makes links in local API responses, emails and docs stay local.
SITE_URL=
