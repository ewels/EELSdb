---
import MobileMenuFooter from './MobileMenuFooter.astro';
import SiteNav from './SiteNav.astro';
---

{/*
  From 50rem, Starlight shows the docs tree as a sidebar column and its own menu button goes away. Up to 999px,
  as on the main site, this burger opens a panel with the site links, the account and the theme toggle.
*/}
<button class="menu-toggle site-menu-toggle" popovertarget="site-menu" aria-label="Menu">
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
    <path class="burger" d="M3 5.5h14M3 10h14M3 14.5h14" />
    <path class="close" d="m4.5 4.5 11 11m0-11-11 11" />
  </svg>
</button>
<div class="site-menu" id="site-menu" popover>
  <SiteNav variant="menu" id="panel" />
  <MobileMenuFooter />
</div>

<style>
  .site-menu-toggle {
    display: none;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .site-menu-toggle:hover {
    background: var(--sunken);
  }
  .site-menu-toggle svg {
    width: 18px;
    height: 18px;
  }
  .site-menu-toggle:has(+ :popover-open) .burger,
  .site-menu-toggle:not(:has(+ :popover-open)) .close {
    display: none;
  }
  .site-menu {
    inset: var(--sl-nav-height) 0 auto;
    width: auto;
    max-height: calc(100dvh - var(--sl-nav-height));
    margin: 0;
    padding: 0 1rem 0.5rem;
    overflow-y: auto;
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  @media (min-width: 50rem) and (max-width: 999px) {
    .site-menu-toggle {
      display: grid;
    }
  }
  @media (min-width: 1000px) {
    .site-menu {
      display: none;
    }
  }
</style>
