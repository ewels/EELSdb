---
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import SiteMenu from './SiteMenu.astro';
import SiteNav from './SiteNav.astro';
---

{/* Laid out like the main site's header: the same 1320px column, the logo left and the rest grouped right. */}
<div class="header">
  <SiteTitle />
  <div class="search print:hidden">
    <Search />
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <ThemeSelect />
    <SiteNav />
  </div>
  <SiteMenu />
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: 1rem 1.4rem;
    width: min(1320px, 100%);
    height: 100%;
    margin-inline: auto;
  }
  .search {
    margin-inline-start: auto;
    flex: 0 1 16rem;
    min-width: 0;
  }
  .search :global(button[data-open-modal]) {
    white-space: nowrap;
  }
  .right-group {
    align-items: center;
    gap: 1.4rem;
  }

  /* Up to 999px the site links, account and theme toggle are in a menu, as on the main site; keep in step with eelsdb.css. */
  @media (max-width: 999px) {
    .right-group {
      display: none;
    }
  }
  @media (max-width: 50rem) {
    .search {
      flex: none;
    }
  }
</style>
