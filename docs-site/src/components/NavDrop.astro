---
import { ABOUT_NAV, currentAbout } from '../../../worker/src/nav';

const { id } = Astro.props;
const path = Astro.url.pathname;
const here = currentAbout(path);
const current = !!here;
---

{/* The main site's About menu (layout.tsx): a button that opens a list, closed by Escape or a click elsewhere. */}
<div class="nav-drop">
  <button type="button" class:list={['drop-toggle', { current }]} aria-expanded="false" aria-controls={id}>
    <span class="drop-label">About</span>
    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m3 4.5 3 3 3-3" />
    </svg>
  </button>
  <ul class="drop-panel" id={id}>
    {ABOUT_NAV.map(([href, label]) => (
      <li><a href={href} aria-current={href === here ? 'page' : undefined}>{label}</a></li>
    ))}
  </ul>
</div>

<script>
  for (const drop of document.querySelectorAll('.nav-drop')) {
    const button = drop.querySelector('.drop-toggle')!;
    const isOpen = () => button.getAttribute('aria-expanded') === 'true';
    const set = (open: boolean) => button.setAttribute('aria-expanded', String(open));
    button.addEventListener('click', () => set(!isOpen()));
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        e.stopImmediatePropagation();
        set(false);
        (button as HTMLElement).focus();
      }
    });
    drop.addEventListener('focusout', (e) => {
      const to = (e as FocusEvent).relatedTarget as Node | null;
      if (to && !drop.contains(to)) set(false);
    });
    addEventListener('click', (e) => {
      const target = e.target as Element;
      if (!drop.contains(target) || target.closest('.drop-panel a')) set(false);
    });
  }
</script>
