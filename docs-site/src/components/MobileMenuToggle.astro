{/* The main site's burger (layout.tsx): three lines that become a cross while the menu is open. */}
<button popovertarget="starlight__sidebar" class="menu-toggle sl-flex md:sl-hidden print:hidden">
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
    <path class="burger" d="M3 5.5h14M3 10h14M3 14.5h14" />
    <path class="close" d="m4.5 4.5 11 11m0-11-11 11" />
  </svg>
  <span class="sr-only">{Astro.locals.t('menuButton.accessibleLabel')}</span>
</button>

<style>
  .menu-toggle {
    position: fixed;
    top: calc((var(--sl-nav-height) - 2.5rem) / 2);
    inset-inline-end: var(--sl-nav-pad-x);
    z-index: var(--sl-z-index-navbar);
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .menu-toggle:hover {
    background: var(--sunken);
  }
  .menu-toggle svg {
    width: 18px;
    height: 18px;
  }
  .menu-toggle:has(~ :popover-open) .burger,
  .menu-toggle:not(:has(~ :popover-open)) .close {
    display: none;
  }
</style>

<style is:global>
  body:has(#starlight__sidebar:popover-open) {
    overflow: hidden;
  }
  @media (min-width: 50rem) {
    body:has(#starlight__sidebar:popover-open) {
      overflow: auto;
    }
  }
</style>
