<button class="theme-toggle" type="button" title="Light or dark">
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="10" cy="10" r="6.5" />
    <path d="M10 3.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" stroke="none" />
  </svg>
  <span class="sr-only"><span class="to-dark">Switch to dark mode</span><span class="to-light">Switch to light mode</span></span>
</button>

<script>
  // As the main site's toggle: remember the choice here, and save it to the account when signed in.
  for (const button of document.querySelectorAll('.theme-toggle')) {
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      if (window.eelsdbAccount.current?.signed_in) {
        fetch('/account/settings/theme/', { method: 'POST', body: new URLSearchParams({ theme: next }) }).catch(() => {});
      }
    });
  }
</script>

<style>
  .theme-toggle { display: grid; place-items: center; width: 2rem; height: 2rem; padding: 0; border: 0; border-radius: 4px; background: none; color: var(--muted); cursor: pointer; }
  .theme-toggle:hover { color: var(--ink); background: var(--sunken); }
  .theme-toggle svg { width: 18px; height: 18px; }
  .to-light, :global(:root[data-theme='dark']) .to-dark { display: none; }
  :global(:root[data-theme='dark']) .to-light { display: inline; }
</style>
