---
// The files are built by python/scripts/logo_files.py; keep the names in sync.
const VERSIONS = [
  ['light-bg', 'For light backgrounds', 'on-light'],
  ['dark-bg', 'For dark backgrounds', 'on-dark'],
  ['black', 'Black', 'on-light'],
  ['white', 'White', 'on-dark'],
];
const { base, name, width, mark = false } = Astro.props;
const items = mark ? [['', 'For icons and avatars, where the full logo is too small', 'on-light']] : VERSIONS;
---

<ul class="logo-grid not-content">
  {items.map(([version, label, bg]) => {
    const file = version ? `${base}-${version}` : base;
    return (
      <li>
        <div class:list={['preview', bg, { mark }]}>
          <img src={`/logo/${file}.svg`} alt={`${name}, ${label.toLowerCase()}`} loading="lazy" />
        </div>
        <p class="label">{label}</p>
        <p class="files">
          <a href={`/logo/${file}.svg`} download>SVG</a>
          <a href={`/logo/${file}.png`} download>PNG, {width} px</a>
        </p>
      </li>
    );
  })}
</ul>

<style>
  .logo-grid { list-style: none; padding: 0; margin: 0.75rem 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem 0.75rem; }
  .preview { aspect-ratio: 16 / 9; display: grid; place-items: center; padding: 1.25rem 1.5rem; border: 1px solid var(--line); border-radius: 6px; }
  .preview img { width: 100%; height: 100%; object-fit: contain; }
  .preview.mark img { width: 45%; }
  .on-light { background: #fbfaf8; }
  .on-dark { background: #141312; }
  .label { font-weight: 500; margin: 0.6rem 0 0; }
  @media (max-width: 40rem) { .logo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .files { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin: 0.15rem 0 0; font-size: 0.875rem; }
</style>
