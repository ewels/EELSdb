---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import { SITE_LINK } from './paths';
import SiteNav from './SiteNav.astro';

const { sidebar } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const unbase = (entries: typeof sidebar) => {
  for (const entry of entries) {
    if (entry.type === 'group') unbase(entry.entries);
    else if (SITE_LINK in entry.attrs) entry.href = entry.href.replace(base, '');
  }
};
unbase(sidebar);
---

{/*
  One docs tree for every width. Up to 60rem it sits inside the main site's menu, under Docs, as the main site's
  burger menu does; wider, it is the plain sidebar and the header carries the site links.
*/}
<SiteNav variant="menu" id="menu">
  <div class="docs-tree">
    <SidebarPersister>
      <SidebarSublist sublist={sidebar} />
    </SidebarPersister>
  </div>
</SiteNav>

<MobileMenuFooter />
