---
import { LOGO_SVG } from '../../../worker/src/pages/logo';
---

<a class="logo" href="/" aria-label="EELSdb home" set:html={LOGO_SVG} />

<style>
  .logo { display: block; width: 170px; flex: none; color: var(--ink); line-height: 0; }
  .logo :global(svg) { width: 100%; height: auto; }
  /* The main site's small logo, at its breakpoint (worker/public/style.css). */
  @media (max-width: 560px) { .logo { width: 104px; } }
</style>
